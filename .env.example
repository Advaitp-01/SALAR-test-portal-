# GEMINI_API_KEY: Required for Gemini AI API calls (Mathematical OCR extraction).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for the Admin Console password gate.
# If unset, the first admin can claim a passcode via the Admin Gate setup UI.
ADMIN_PASSCODE=

# OWNER_USERNAME / OWNER_PASSWORD: Optional Platform Owner credentials for /owner.
# If unset, the first owner claims the account securely via the Owner Console setup flow.
OWNER_USERNAME=
OWNER_PASSWORD=

# Optional SaaS DNS Automation Secrets (Server-side only)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Optional Vercel / Production SaaS Config
# SESSION_SECRET: Recommended 64-char hex secret so HTTP-only sessions persist across serverless instances.
SESSION_SECRET=
# WILDCARD_DOMAIN_BASE: Base domain for generated client portal subdomains (default: salartech.com).
WILDCARD_DOMAIN_BASE=salartech.com
# SALAR_DATA_DIR / SALAR_UPLOADS_DIR: Optional writable data directories (on Vercel defaults to /tmp automatically).
SALAR_DATA_DIR=
SALAR_UPLOADS_DIR=

